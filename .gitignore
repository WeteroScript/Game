# ---- IDE / project files ----
.vs/
.vscode/*
# но кнопки-задачи для телефонного сценария оставляем в репозитории
!.vscode/tasks.json
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.booproj
*.svd
crashlytics-build.properties
/[Aa]ssets/[Aa]sset[Bb]undle[Cc]ache/

# ---- OS ----
.DS_Store
Thumbs.db

# never commit a Unity licence (secret!) or local licence helper state
*.ulf
*.alf
Unity_lic.*

# ---- Godot (порт без Unity) ----
godot/.godot/
godot/android/
godot/build/
export_presets.cfg.bak

# локальные скриншоты для ревью
.shots/

# референсные фото для сверки моделей — не коммитим
image-search/
.shots*/
.glb/
