; Настройки проекта Godot 4.3 — порт игры «Kugoo Freeride» без Unity.
; Запуск: godot --path godot
; Сборка APK: .github/workflows/godot-android.yml

config_version=5

[application]

config/name="Kugoo Freeride"
config/description="Аркада про электросамокаты KugooKirin G4 и Kugoo F3 Pro Max"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/version="1.0.0"
boot_splash/bg_color=Color(0.05, 0.06, 0.08, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=14.0
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)

[input_devices]

pointing/emulate_mouse_from_touch=true
